{% include "_head.html.j2" %}
<style>
  main.brief { max-width: 1240px; }
  .brief .two { display: grid; grid-template-columns: 1.35fr 1fr; gap: 22px; align-items: start; }
  .brief .problem { display: grid; grid-template-columns: 1.15fr 1fr; gap: 22px; align-items: center; }
  .brief .problem figure { margin: 0; }
  /* A grid column is never narrower than its content unless told so: without min-width 0 a table
     with long cells pushes its column, and the page, wider than the window. Cells wrap here; each
     number stays on one line with its unit (a formula is never broken; a cell's lines end in <br>). */
  .brief .two > *, .brief .problem > * { min-width: 0; }
  .brief td.num { white-space: normal; overflow-wrap: break-word; }
  .brief td:first-child { min-width: 92px; }
  /* An answer of several values: a heading row (.grp), then one row per value with its name (.ln). */
  .brief .grp { font-weight: 600; }
  .brief .ln { display: inline-block; padding-left: 14px; color: var(--ink2); white-space: nowrap; }
  .brief tr:has(.grp) td { border-bottom: none; padding-bottom: 1px; }
  .brief tr:has(.ln) td { padding-top: 2px; padding-bottom: 2px; }
  .brief tr:has(.ln:not(.last)) td { border-bottom: none; }
  .brief tr:has(.ln.last) td { padding-bottom: 7px; }
  .brief ul.answer { margin: 4px 0 16px; } .brief ul.answer li { font-size: 17px; margin: 5px 0; }
  .brief .what { font-size: 14px; color: var(--ink2); margin: 4px 0 4px; } .brief .what b { color: var(--ink); }
  .brief table { font-size: 14px; }
  .brief th, .brief td { padding: 6px 8px; }
  .brief .miss { color: #b03a2e; font-weight: 700; }
  .brief .wait { color: var(--muted); font-style: italic; }
  .brief .small { font-size: 13.5px; color: var(--muted); margin-top: 6px; }
  .brief h2 { margin-bottom: 8px; }
  .brief section { padding-top: 14px; padding-bottom: 14px; }
  @media (max-width: 980px) { .brief .two, .brief .problem { grid-template-columns: 1fr; } }
  @media print { .brief section { break-inside: avoid; } body { font-size: 12px; } }
</style>
<body>
<main class="brief">
{% macro table(t, note_first=false) -%}
  {% if note_first and t.get('note') %}<p class="what">{{ t.note }}</p>{% endif %}
  <div class="table-wrap"><table class="full">
    <tr>{% for h in t.head %}<th class="{{ '' if loop.first else 'num' }}">{{ h }}</th>{% endfor %}</tr>
    {% for row in t.rows %}
    {% if 'class="grp"' in row[0] %}<tr><td colspan="{{ row|length }}">{{ row[0] }}</td></tr>
    {% else %}<tr>{% for c in row %}<td class="{{ '' if loop.first else 'num' }}">{{ c }}</td>{% endfor %}</tr>{% endif %}
    {% endfor %}
  </table></div>
  {% if not note_first and t.get('note') %}<p class="small">{{ t.note }}</p>{% endif %}
{%- endmacro %}
<header>
  <div class="kicker">Agentic CFD progress report · {{ r.date }}</div>
  <h1>{{ r.title }}</h1>
  {% if r.get('outcome') %}<div class="{{ r.outcome.css }}" style="margin-top: 8px"><span class="verdict">{{ r.outcome.mark }} {{ r.outcome.label }}</span></div>
  {% elif r.get('verdict') %}<div class="{{ r.verdict }}" style="margin-top: 8px"><span class="verdict">Verdict of the case: {{ r.verdict }}</span></div>{% endif %}
</header>

<section id="goal">
  <h2>Goal</h2>
  <p class="headline">{{ r.goal }}</p>
  <p class="lead">{{ r.story }}</p>
</section>

<section id="problem">
  <h2>The problem</h2>
  <div class="problem">
    <figure>{{ sketch }}</figure>
    <div>
      <ul class="points">{% for x in r.problem.requirements %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section id="results">
  <h2>Results</h2>
  {% if r.results.get('answer') %}<ul class="points answer">{% for x in r.results.answer %}<li>{{ x }}</li>{% endfor %}</ul>
  {% else %}<p class="headline">{{ r.results.headline }}</p>{% endif %}
  <div class="two">
    <div><h4>{{ r.accuracy.title }}</h4>{{ table(r.accuracy, note_first=true) }}</div>
    <div><h4>{{ r.speed.title }}</h4>{{ table(r.speed) }}</div>
  </div>
  <div class="two" style="margin-top: 14px">
    <div class="callout info"><span class="tag">What it means</span><ul class="points">{% for x in r.results.meaning %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="callout warn"><span class="tag">Limits</span><ul class="points">{% for x in r.results.limits %}<li>{{ x }}</li>{% endfor %}</ul></div>
  </div>
  <p class="small">Details: {% for l in r.links %}<a href="{{ l.href }}">{{ l.text }}</a>{{ " · " if not loop.last else "" }}{% endfor %}</p>
</section>
</main>
</body>
</html>
