{% include "_head.html.j2" %}
<style>
  main.brief { max-width: 1240px; }
  .brief .two { display: grid; grid-template-columns: 1.35fr 1fr; gap: 22px; align-items: start; }
  .brief .problem { display: grid; grid-template-columns: 1.15fr 1fr; gap: 22px; align-items: center; }
  .brief .problem figure { margin: 0; }
  .brief table { font-size: 14px; }
  .brief th, .brief td { padding: 6px 8px; }
  .brief .miss { color: #b03a2e; font-weight: 700; }
  .brief .wait { color: var(--muted); font-style: italic; }
  .brief .small { font-size: 13.5px; color: var(--muted); margin-top: 6px; }
  .brief h2 { margin-bottom: 8px; }
  .brief section { padding-top: 14px; padding-bottom: 14px; }
  @media (max-width: 980px) { .brief .two, .brief .problem { grid-template-columns: 1fr; } }
  @media print { .brief section { break-inside: avoid; } body { font-size: 12px; } }
</style>
<body>
<main class="brief">
{% macro table(t) -%}
  <div class="table-wrap"><table class="full">
    <tr>{% for h in t.head %}<th class="{{ '' if loop.first else 'num' }}">{{ h }}</th>{% endfor %}</tr>
    {% for row in t.rows %}
    <tr>{% for c in row %}<td class="{{ '' if loop.first else 'num' }}">{{ c }}</td>{% endfor %}</tr>
    {% endfor %}
  </table></div>
  {% if t.get('note') %}<p class="small">{{ t.note }}</p>{% endif %}
{%- endmacro %}
<header>
  <div class="kicker">Agentic CFD progress report · {{ r.date }}</div>
  <h1>{{ r.title }}</h1>
  {% if r.get('verdict') %}<div class="{{ r.verdict }}" style="margin-top: 8px"><span class="verdict">Verdict of the case: {{ r.verdict }}</span></div>{% endif %}
</header>

<section id="goal">
  <h2>Goal</h2>
  <p class="headline">{{ r.goal }}</p>
  <p class="lead">{{ r.story }}</p>
</section>

<section id="problem">
  <h2>The problem</h2>
  <div class="problem">
    <figure>{{ sketch }}</figure>
    <div>
      <ul class="points">{% for x in r.problem.requirements %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section id="results">
  <h2>Results</h2>
  <p class="headline">{{ r.results.headline }}</p>
  <div class="two">
    <div><h4>{{ r.accuracy.title }}</h4>{{ table(r.accuracy) }}</div>
    <div><h4>{{ r.speed.title }}</h4>{{ table(r.speed) }}</div>
  </div>
  <div class="two" style="margin-top: 14px">
    <div class="callout info"><span class="tag">What it means</span><ul class="points">{% for x in r.results.meaning %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="callout warn"><span class="tag">Limits</span><ul class="points">{% for x in r.results.limits %}<li>{{ x }}</li>{% endfor %}</ul></div>
  </div>
  <p class="small">Details: {% for l in r.links %}<a href="{{ l.href }}">{{ l.text }}</a>{{ " · " if not loop.last else "" }}{% endfor %}</p>
</section>
</main>
</body>
</html>
