{% include "_head.html.j2" %}
<body>
<main>
{% macro figures(section) -%}
  {% for f in figs if f.section == section %}
  <figure class="{{ section }}" style="--w: {{ f.width_px }}px">{{ f.svg }}
    <figcaption><b>Figure {{ f.number }}.</b> {{ f.caption }}</figcaption></figure>
  {% endfor %}
{%- endmacro %}
{% macro table(t, full=false) -%}
  <div class="table-wrap"><table class="{{ 'full' if full else '' }}">
    <tr>{% for h in t.head %}<th class="{{ '' if loop.first else 'num' }}">{{ h }}</th>{% endfor %}</tr>
    {% for row in t.rows %}
    <tr>{% for c in row %}<td class="{{ '' if loop.first else 'num' }}">{{ c }}</td>{% endfor %}</tr>
    {% endfor %}
  </table></div>
{%- endmacro %}
{% macro checks_table(rows) -%}
  <div class="table-wrap"><table class="full">
    <tr><th>Check</th><th>Result</th><th>Status</th><th>What it means</th></tr>
    {% for c in rows %}
    <tr><td><b>{{ c.name }}</b></td><td>{{ c.value }}</td><td><span class="status {{ c.status }}">{{ check_legend[c.status] }}</span></td>
        <td>{{ c.meaning }}</td></tr>
    {% endfor %}
  </table></div>
{%- endmacro %}

<header>
  <div class="kicker">Agentic CFD report · {{ r.date }}</div>
  <h1>{{ r.title }}</h1>
  <nav class="toc">
    <a href="#summary">Summary</a><a href="#problem">1 Problem</a><a href="#assumptions">2 Assumptions</a>
    <a href="#theory">3 Theory</a><a href="#decisions">4 Decisions</a><a href="#preflight">5 Pre-flight test</a>
    <a href="#simulation">6 Simulation</a><a href="#comparison">7 Comparison</a><a href="#insights">8 Workflow insights</a>
    <a href="#repro">A Reproducibility</a>{% if r.performance is defined %}<a href="#performance">B Performance</a>{% endif %}
  </nav>
</header>

<!-- ============================== SUMMARY ============================== -->
<section id="summary" class="summary {{ r.verdict }}">
  <h2>Summary <span class="verdict">{{ {'PASS': '✓', 'WARN': '⚠', 'FAIL': '✗'}[r.verdict] }} {{ r.verdict }}</span>
      <span class="ctype">{{ r.comparison_type | capitalize }}</span></h2>
  <p class="headline">{{ r.summary.headline }}</p>
  <h4>Answers to the request</h4>
  <div class="table-wrap"><table class="answers full">
    <tr>{% for h in r.summary.answer_columns %}<th class="{{ 'num' if loop.last else '' }}">{{ h }}</th>{% endfor %}</tr>
    {% for a in r.summary.answers %}
    <tr><td><div class="req"><span class="letter">{{ a.letter }}</span><span>{{ a.label }}</span></div></td><td>{{ a.theory }}</td><td>{{ a.sim }}</td>
        <td class="num">{{ a.diff }}</td></tr>
    {% endfor %}
  </table></div>
  <h4>Key findings</h4>
  <ul class="points">{% for b in r.summary.findings %}<li>{{ b }}</li>{% endfor %}</ul>
  {% for l in r.summary.limitations %}<div class="callout warn"><span class="tag">Limitation</span>{{ l }}</div>{% endfor %}
</section>

<!-- ============================== 1 PROBLEM ============================== -->
<section id="problem">
  <h2><span class="num">1</span> Problem</h2>
  <p class="lead">{{ r.problem.description }}</p>
  <div class="wanted">
    <h4>What we want to find</h4>
    <ol>{% for w in r.problem.wanted %}<li><span class="letter">{{ w.letter }}</span><span>{{ w.text }}</span></li>{% endfor %}</ol>
  </div>
  {% if r.problem.setup is defined and r.problem.setup %}
  <h4>Setup</h4>
  <ul class="points">{% for s in r.problem.setup %}<li>{{ s }}</li>{% endfor %}</ul>
  {% endif %}
  {{ figures('problem') }}
  <h4>Given data</h4>
  <div class="table-wrap"><table>
    <tr><th>Quantity</th><th>Symbol</th><th class="num">Value</th><th>Unit</th></tr>
    {% for x in r.problem.given %}
    <tr><td>{{ x.label }}</td><td>{{ x.symbol }}</td><td class="num">{{ x.value }}</td><td>{{ x.unit }}</td></tr>
    {% endfor %}
  </table></div>
  {% if r.problem.reference is defined and r.problem.reference %}
  <div class="callout info"><span class="tag">Reference data supplied</span>{{ r.problem.reference }}</div>
  {% endif %}
</section>

<!-- ============================== 2 ASSUMPTIONS ============================== -->
<section id="assumptions">
  <h2><span class="num">2</span> Assumptions</h2>
  <p class="lead">Both the theory and the simulation rely on these. The status column says how each one was established:</p>
  <div class="chips">
    {% for s in assumption_legend %}<div class="chip"><span class="status {{ s.status }}">{{ s.label }}</span><br>{{ s.meaning }}</div>{% endfor %}
  </div>
  {% set labels = {} %}{% for s in assumption_legend %}{% set _ = labels.update({s.status: s.label}) %}{% endfor %}
  <div class="table-wrap"><table class="full">
    <tr><th>Assumption</th><th>Justification</th><th>Status</th></tr>
    {% for a in r.assumptions.rows %}
    <tr><td><b>{{ a.name }}</b></td><td>{{ a.check }}</td><td><span class="status {{ a.status }}">{{ labels[a.status] }}</span></td></tr>
    {% endfor %}
  </table></div>
</section>

<!-- ============================== 3 THEORY ============================== -->
<section id="theory">
  <h2><span class="num">3</span> Theory</h2>
  <p class="lead">{{ r.theory.intro }}</p>
  {% for s in r.theory.steps %}
  <div class="step"><div class="label">{{ s.label }}</div><div class="eq">\[ {{ s.latex }} \]</div><div class="note">{{ s.note }}</div></div>
  {% endfor %}
  {% if r.theory.self_checks %}
  <ul class="checks">{% for c in r.theory.self_checks %}<li class="{{ '' if c.ok else 'bad' }}">{{ c.name }}</li>{% endfor %}</ul>
  {% endif %}
  {{ figures('theory') }}
  {% if r.theory.derived %}
  <h3>Derived quantities</h3>
  <p class="lead">Evaluated with the given data. Open ⓘ for what each quantity means and the formula with the numbers plugged in, to check it by hand.</p>
  <div class="cards">
    {% for d in r.theory.derived %}
    <div class="card">
      <div class="title">{{ d.label }}</div>
      <div class="value">\( {{ d.symbol }} = {{ d.value_tex }}\ {{ d.unit_tex }} \)</div>
      <div class="eq">\( \displaystyle {{ d.formula }} \)</div>
      <details class="hint">
        <summary><span class="i">i</span>Why it matters · check it by hand</summary>
        <div class="body">
          <div>{{ d.why }}</div>
          {% if d.params %}
          <table>
            <tr><th>Symbol</th><th>Meaning here</th><th class="num">Value</th></tr>
            {% for p in d.params %}<tr><td>\( {{ p.tex }} \)</td><td>{{ p.meaning }}</td><td class="num">\( {{ p.value | tnum }}\ {{ p.unit }} \)</td></tr>{% endfor %}
          </table>
          {% endif %}
          <div class="eq">\[ {{ d.check }} \]</div>
        </div>
      </details>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

<!-- ============================== 4 DECISIONS ============================== -->
<section id="decisions">
  <h2><span class="num">4</span> Decisions</h2>
  <p class="lead">Every modelling and numerical choice that can change the result. Each one is tagged with the kind of influence
    it has on the answer; a checker verifies that every OpenFOAM setting in the case files belongs to one of them.</p>
  <div class="kinds">
    {% for k, meaning in decision_kinds.items() %}<div class="chip"><span class="kind {{ k }}">{{ k | capitalize }}</span><br>{{ meaning }}</div>{% endfor %}
  </div>
  <h4>At a glance</h4>
  <div class="table-wrap"><table class="glance full">
    {% for area, items in decision_groups %}{% for d in items %}
    <tr><td class="n"><span class="dnum">D{{ d.num }}</span></td><td><a href="#d{{ d.num }}">{{ d.choice }}</a></td>
        <td class="areaname">{{ area }}</td><td class="k"><span class="kind {{ d.kind }}">{{ d.kind | capitalize }}</span></td></tr>
    {% endfor %}{% endfor %}
  </table></div>
  {% for area, items in decision_groups %}
  <div class="area">{{ area }}</div>
  {% for d in items %}
  <article class="dcard {{ d.kind }}" id="d{{ d.num }}">
    <header><span class="dnum">D{{ d.num }}</span><div class="choice">{{ d.choice }}</div><span class="kind {{ d.kind }}">{{ d.kind | capitalize }}</span></header>
    <div class="dbody">
      <div class="why"><div class="lbl">Why this choice</div>{{ d.why }}</div>
      <div class="side">
        <div><div class="lbl">Effect on the result</div>{{ d.affects }}</div>
        <div><div class="lbl">Alternatives</div>{{ d.alternatives }}</div>
      </div>
    </div>
    <footer><span class="lbl">OpenFOAM settings</span>{% for x in d.settings %}<code>{{ x }}</code>{% endfor %}</footer>
  </article>
  {% endfor %}
  {% endfor %}
</section>

<!-- ============================== 5 PREFLIGHT ============================== -->
<section id="preflight">
  <h2><span class="num">5</span> Pre-flight test</h2>
  <p class="lead">{{ r.preflight.purpose }}</p>
  <div class="table-wrap"><table class="full">
    <tr><th>Test run</th><th>Setup</th><th>Outcome</th></tr>
    {% for x in r.preflight.runs %}<tr><td><b>{{ x.name }}</b></td><td>{{ x.setup }}</td><td>{{ x.outcome }}</td></tr>{% endfor %}
  </table></div>
  {{ checks_table(r.preflight.checks) }}
  {{ figures('preflight') }}
  <div class="callout {{ 'good' if 'fail' not in r.preflight.checks | map(attribute='status') else 'warn' }}"><span class="tag">Conclusion</span>{{ r.preflight.conclusion }}</div>
</section>

<!-- ============================== 6 SIMULATION ============================== -->
<section id="simulation">
  <h2><span class="num">6</span> Simulation</h2>
  <h3><span class="num">6.1</span>From the real problem to the simulation model</h3>
  <div class="table-wrap"><table class="full">
    <tr><th>Aspect</th><th>Real problem</th><th>Simulation model</th></tr>
    {% for x in r.simulation.model %}<tr><td><b>{{ x.aspect }}</b></td><td>{{ x.real }}</td><td>{{ x.model }}</td></tr>{% endfor %}
  </table></div>
  <h3><span class="num">6.2</span>Meshes</h3>
  <p class="lead">{{ r.simulation.meshes.intro }}</p>
  {{ table(r.simulation.meshes) }}
  <h3><span class="num">6.3</span>Results</h3>
  {{ figures('simulation') }}
  {{ table(r.simulation.results) }}
  <h3><span class="num">6.4</span>Run health</h3>
  {{ figures('convergence') }}
  {{ table(r.simulation.health) }}
  <ul class="notes">{% for n in r.simulation.health.notes %}<li>{{ n }}</li>{% endfor %}</ul>
</section>

<!-- ============================== 7 COMPARISON ============================== -->
<section id="comparison">
  <h2><span class="num">7</span> Comparison</h2>
  <p class="lead">{{ r.comparison.kind }}</p>
  <h4>How the differences are measured</h4>
  <div class="defs">
    {% for d in r.comparison.definitions %}
    <div class="def"><div class="name">{{ d.name }}</div><div class="eq">\[ {{ d.latex }} \]</div><div class="meaning">{{ d.meaning }}</div></div>
    {% endfor %}
  </div>
  {{ figures('comparison') }}
  {{ table(r.comparison) }}
  {% for f in r.comparison.findings %}<div class="callout info">{{ f }}</div>{% endfor %}
</section>

<!-- ============================== 8 INSIGHTS ============================== -->
<section id="insights">
  <h2><span class="num">8</span> Workflow insights</h2>
  <p class="lead">Problems met while producing this report, logged at the moment they happened, with how they were solved and what
    future agents should do differently. These feed back into the workflow guidelines.</p>
  {% for it in insights %}
  <div class="insight {{ it.status | default('resolved') }}">
    <div class="meta"><span class="stage">{{ it.stage }}</span><span class="when">logged {{ it.logged }}</span>
      {% if it.status | default('resolved') == 'open' %}<span class="open-tag">✗ Unresolved</span>{% endif %}</div>
    <dl><dt>Problem</dt><dd>{{ it.problem }}</dd>
      {% for k, lab in [('diagnosis', 'Diagnosis'), ('fix', 'Fix'), ('lesson', 'Lesson'), ('guideline', 'Guideline')] %}
      {% if it[k] is defined and it[k] %}<dt>{{ lab }}</dt><dd>{{ it[k] }}</dd>{% endif %}{% endfor %}</dl>
  </div>
  {% endfor %}
</section>

<!-- ============================== APPENDIX ============================== -->
<section id="repro">
  <h2><span class="num">A</span> Reproducibility</h2>
  <p class="lead">Everything needed to produce this report again. Commands run inside WSL from the project folder.</p>
  <h4>Re-run it</h4>
  <div class="rerun"><ol>
    {% for c in r.reproducibility.commands %}<li><code>{{ c.cmd | e }}</code><span class="what">{{ c.what }}</span></li>{% endfor %}
  </ol></div>
  <div class="repro-grid">
    <div class="panel"><h4>Case files</h4><ul>
      {% for f in r.reproducibility.files %}<li><code>{{ f.path | e }}</code><span class="what">{{ f.what }}</span></li>{% endfor %}
    </ul></div>
    <div class="panel"><h4>Run directories</h4><ul>
      {% for f in r.reproducibility.run_dirs %}<li><code>{{ f.path | e }}</code><span class="what">{{ f.what }}</span></li>{% endfor %}
    </ul>
    <h4 style="margin-top:16px">Environment</h4>
    <table>{% for k, v in r.reproducibility.environment %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>
  </div>
  {% if r.reproducibility.notes is defined and r.reproducibility.notes %}
  <ul class="notes">{% for n in r.reproducibility.notes %}<li>{{ n }}</li>{% endfor %}</ul>
  {% endif %}
</section>

{% if r.performance is defined %}
<!-- ============================== APPENDIX B ============================== -->
<section id="performance">
  <h2><span class="num">B</span> Performance</h2>
  <p class="lead">{{ r.performance.intro }}</p>
  {{ figures('performance') }}
  {{ table(r.performance, full=true) }}
  <ul class="notes">{% for n in r.performance.notes %}<li>{{ n }}</li>{% endfor %}</ul>
</section>
{% endif %}

<footer>Every number in this report was computed by code (results.json); none was typed by the agent.
  The report passed the automatic contract check.</footer>
</main>
</body>
</html>
