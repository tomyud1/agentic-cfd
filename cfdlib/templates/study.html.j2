{% include "_head.html.j2" %}
<body>
<main>
{% macro figure(f) -%}
  <figure class="{{ f.section }}" style="--w: {{ f.width_px }}px">{{ f.svg }}
    <figcaption><b>Figure {{ f.number }}.</b> {{ f.caption }}</figcaption></figure>
{%- endmacro %}
{# figures of a section that no table claims; a figure named by a table is drawn right above that table #}
{% macro figures(section) -%}
  {% for f in figs.values() if f.section == section and not f.at_table %}
  {{ figure(f) }}
  {% endfor %}
{%- endmacro %}
{% macro table(t, full=false, titled=true) -%}
  {% if titled and t.get('title') %}<h4>{{ t.title }}</h4>{% endif %}
  {% if t.get('question') %}<dl class="qrm"><dt>Question</dt><dd>{{ t.question }}</dd></dl>{% endif %}
  {% if t.get('figure') %}{{ figure(figs[t.figure]) }}{% endif %}
  <div class="table-wrap"><table class="{{ 'full' if full else '' }}">
    <tr>{% for h in t.head %}<th class="{{ '' if loop.first else 'num' }}">{{ h }}</th>{% endfor %}</tr>
    {% for row in t.rows %}
    <tr>{% for c in row %}<td class="{{ '' if loop.first else 'num' }}{{ ' nw' if loop.index0 in t.nowrap else '' }}">{{ c }}</td>{% endfor %}</tr>
    {% endfor %}
  </table></div>
  {% if t.get('result') or t.get('meaning') %}<dl class="qrm">
    {% if t.get('result') %}<dt>Result</dt><dd>{{ t.result }}</dd>{% endif %}
    {% if t.get('meaning') %}<dt>What it means</dt><dd>{{ t.meaning }}</dd>{% endif %}
  </dl>{% endif %}
  {% if t.get('note') %}<p class="lead" style="margin-top:8px;font-size:14px">{{ t.note }}</p>{% endif %}
{%- endmacro %}

{% macro setup_body(d) -%}
  <p class="lead">{{ d.intro }}</p>
  {% if d.get('terms') %}
  <h4>Words used on this page</h4>
  <ul class="points">{% for t in d.terms %}<li><b>{{ t.term }}.</b> {{ t.meaning }}</li>{% endfor %}</ul>
  {% endif %}
  {{ figures('setup') }}
  <div class="repro-grid">
    <div class="panel"><h4>Hardware</h4><table>{% for k, v in d.hardware %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>
    <div class="panel"><h4>Software</h4><table>{% for k, v in d.software %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>
  </div>
  <h4>Rules for a fair comparison</h4>
  <ul class="points">{% for f in d.fairness %}<li>{{ f }}</li>{% endfor %}</ul>
{%- endmacro %}
{% macro method_body(d) -%}
  <p class="lead">{{ d.intro }}</p>
  {% for c in d.choices %}
  <article class="dcard solver">
    <header><span class="dnum">M{{ loop.index }}</span><div class="choice">{{ c.choice }}</div></header>
    <div class="dbody">
      <div class="why"><div class="lbl">Why this choice</div>{{ c.why }}</div>
      <div class="side"><div><div class="lbl">Alternatives</div>{{ c.alternatives }}</div></div>
    </div>
  </article>
  {% endfor %}
{%- endmacro %}
{% macro tables_body(key, d, notes_as_list=false) -%}
  <p class="lead">{{ d.intro }}</p>
  {{ figures(key) }}
  {% for t in d.tables %}{{ table(t, full=true) }}{% endfor %}
  {% if notes_as_list %}<ul class="notes">{% for n in d.notes %}<li>{{ n }}</li>{% endfor %}</ul>
  {% else %}{% for n in d.notes %}<div class="callout info">{{ n }}</div>{% endfor %}{% endif %}
{%- endmacro %}
{% macro same_body(d) -%}
  <p class="lead">{{ d.intro }}</p>
  {{ figures('same_answer') }}
  {{ table(d, full=true, titled=false) }}
  <div class="callout {{ 'info' if d.ok else 'warn' }}"><span class="tag">{{ '✓ Same answer' if d.ok else '⚠ Answers differ' }}</span>{{ d.verdict }}</div>
{%- endmacro %}

<header>
  <div class="kicker">Agentic CFD {{ r.kicker }} · {{ r.date }}</div>
  <h1>{{ r.title }}</h1>
  <nav class="toc">
    <a href="#summary">Summary</a>{% for sec in r.secs %}<a href="#{{ sec.id }}">{{ sec.num }} {{ sec.title }}</a>{% endfor %}
    <a href="#insights">{{ r.n_insights }} Insights</a><a href="#repro">A Reproducibility</a>
  </nav>
</header>

<section id="summary" class="summary {{ r.verdict }}">
  <h2>Summary <span class="verdict">{{ r.verdict_label }}</span></h2>
  <p class="headline"><b>Question.</b> {{ r.question }}</p>
  <p class="headline">{{ r.summary.headline }}</p>
  {% if r.summary.get('reasons') %}<div class="callout warn" style="margin-bottom:14px"><span class="tag">Why this verdict</span>
    <ul class="points">{% for x in r.summary.reasons %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
  <h4>Key numbers</h4>
  <div class="table-wrap"><table class="answers full">
    <tr><th>Measure</th><th>Value</th><th>What it means</th></tr>
    {% for a in r.summary.answers %}<tr><td><b>{{ a.label }}</b></td><td>{{ a.value }}</td><td>{{ a.note }}</td></tr>{% endfor %}
  </table></div>
  <h4>Key findings</h4>
  <ul class="points">{% for b in r.summary.findings %}<li>{{ b }}</li>{% endfor %}</ul>
  {% for l in r.summary.limitations %}<div class="callout warn"><span class="tag">Limitation</span>{{ l }}</div>{% endfor %}
  {% if r.summary.get('recommendation') %}<div class="callout info"><span class="tag">Recommendation</span>{{ r.summary.recommendation }}</div>{% endif %}
</section>

{% for sec in r.secs %}
<section id="{{ sec.id }}">
  <h2><span class="num">{{ sec.num }}</span> {{ sec.title }}</h2>
  {% if sec.kind == 'setup' %}{{ setup_body(r.setup) }}
  {% elif sec.kind == 'method' %}{{ method_body(r.method) }}
  {% elif sec.kind == 'results' %}{{ tables_body('results', r.results) }}
  {% elif sec.kind == 'same_answer' %}{{ same_body(r.same_answer) }}
  {% elif sec.kind == 'breakdown' %}{{ tables_body('breakdown', r.breakdown, notes_as_list=true) }}
  {% else %}{{ tables_body(sec.key, sec.extra) }}{% endif %}
</section>
{% endfor %}

<section id="insights">
  <h2><span class="num">{{ r.n_insights }}</span> Insights</h2>
  <p class="lead">Performance and GPU entries of the case's live insight log: what limited speed, what helped, what to try next.
    Each entry shows its problem; open it for the diagnosis, the fix and the lesson.</p>
  {% for it in insights %}
  {% set status = it.status | default('resolved') %}
  <details class="insight {{ status }}"{{ ' open' if status == 'open' else '' }}>
    <summary><span class="stage">{{ it.stage }}</span> <span class="when">logged {{ it.logged }}</span>
      {% if status == 'open' %}<span class="open-tag">✗ Unresolved</span>{% endif %}
      <div class="prob">{{ it.problem }}</div></summary>
    <dl>
      {% for k, lab in [('diagnosis', 'Diagnosis'), ('fix', 'Fix'), ('lesson', 'Lesson'), ('guideline', 'Guideline')] %}
      {% if it[k] is defined and it[k] %}<dt>{{ lab }}</dt><dd>{{ it[k] }}</dd>{% endif %}{% endfor %}</dl>
  </details>
  {% endfor %}
</section>

<section id="repro">
  <h2><span class="num">A</span> Reproducibility</h2>
  <p class="lead">Everything needed to repeat the measurements. Commands run inside WSL from the project folder.</p>
  <h4>Re-run it</h4>
  <div class="rerun"><ol>
    {% for c in r.reproducibility.commands %}<li><code>{{ c.cmd | e }}</code><span class="what">{{ c.what }}</span></li>{% endfor %}
  </ol></div>
  <div class="repro-grid">
    <div class="panel"><h4>Files</h4><ul>
      {% for f in r.reproducibility.files %}<li><code>{{ f.path | e }}</code><span class="what">{{ f.what }}</span></li>{% endfor %}
    </ul></div>
    <div class="panel"><h4>Run directories</h4><ul>
      {% for f in r.reproducibility.run_dirs %}<li><code>{{ f.path | e }}</code><span class="what">{{ f.what }}</span></li>{% endfor %}
    </ul>
    <h4 style="margin-top:16px">Environment</h4>
    <table>{% for k, v in r.reproducibility.environment %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>
  </div>
  {% if r.reproducibility.get('notes') %}
  <ul class="notes">{% for n in r.reproducibility.notes %}<li>{{ n }}</li>{% endfor %}</ul>
  {% endif %}
</section>

<footer>Every number in this study was computed by code (study.json); none was typed by the agent.
  The study passed the automatic contract check. Main report of this case: <a href="report.html">report.html</a>.</footer>
</main>
</body>
</html>
