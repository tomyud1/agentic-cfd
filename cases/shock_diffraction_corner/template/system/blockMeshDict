FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Chamber 0 <= x <= L, 0 <= y <= H in {{ N }} x {{ N }} equal square cells, one cell deep ({{ depth }} m, empty).
// Two blocks, split at the height of the corner, so that the left side has two patches:
// the step face (a wall) below the corner and the duct's opening (inlet) above it.
scale   1;

vertices
(
    (0       0        0)
    ({{ L }} 0        0)
    ({{ L }} {{ Hs }} 0)
    (0       {{ Hs }} 0)
    ({{ L }} {{ H }}  0)
    (0       {{ H }}  0)
    (0       0        {{ depth }})
    ({{ L }} 0        {{ depth }})
    ({{ L }} {{ Hs }} {{ depth }})
    (0       {{ Hs }} {{ depth }})
    ({{ L }} {{ H }}  {{ depth }})
    (0       {{ H }}  {{ depth }})
);

blocks
(
    hex (0 1 2 3 6 7 8 9)   ({{ N }} {{ n_low }} 1) simpleGrading (1 1 1)
    hex (3 2 4 5 9 8 10 11) ({{ N }} {{ n_up }} 1) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type            patch;
        faces           ((3 9 11 5));
    }
    walls
    {
        type            wall;
        faces           ((0 6 9 3) (0 1 7 6) (1 2 8 7) (2 4 10 8) (5 11 10 4));
    }
    frontAndBack
    {
        type            empty;
        faces           ((0 3 2 1) (3 5 4 2) (6 7 8 9) (9 8 10 11));
    }
);
