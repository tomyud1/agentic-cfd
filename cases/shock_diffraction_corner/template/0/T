FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform {{ T0 }};

boundaryField
{
    // T2 = p2 / (rho2 R): the solver takes pressure and temperature, the density follows.
    inlet
    {
        type            fixedValue;
        value           uniform {{ T2 }};
    }
    // No heat through the walls.
    walls
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
