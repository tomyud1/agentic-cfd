FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Generated by cases/dfg_cylinder_3d_re20/run.py (mesh_spec): O-grid around the cylinder + 8 channel blocks,
// extruded over 0 <= z <= H with cells graded towards both side walls.
scale   1;

vertices
(
{% for v in vertices %}    ({{ "%.12g" % v[0] }} {{ "%.12g" % v[1] }} {{ "%.12g" % v[2] }})   // {{ loop.index0 }}
{% endfor %});

blocks
(
{% for b in blocks %}    hex ({{ b.v | join(' ') }}) ({{ b.n[0] }} {{ b.n[1] }} {{ nz }}) simpleGrading ({{ "%.12g" % b.g[0] }} {{ "%.12g" % b.g[1] }} {{ z_grading }})   // {{ b.name }}
{% endfor %});

edges
(
{% for e in arcs %}    arc {{ e[0] }} {{ e[1] }} ({{ "%.12g" % e[2][0] }} {{ "%.12g" % e[2][1] }} {{ "%.12g" % e[2][2] }})
{% endfor %});

boundary
(
{% for name, p in patches.items() %}    {{ name }}
    {
        type {{ p.type }};
        faces
        (
{% for f in p.faces %}            ({{ f | join(' ') }})
{% endfor %}        );
    }
{% endfor %});

mergePatchPairs
(
);
