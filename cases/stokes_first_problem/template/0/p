FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Kinematic pressure p/rho. Nothing drives a pressure gradient, so p stays ~0.
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    plate
    {
        type            zeroGradient;
    }
    top
    {
        type            symmetryPlane;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}
