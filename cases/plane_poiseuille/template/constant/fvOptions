FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}

// The pressure gradient, applied as a uniform body force per unit mass:
// a = -(dp/dx) / rho  [m/s^2]. Periodic ends then carry no net pressure drop.
pressureGradientSource
{
    type            vectorSemiImplicitSource;
    selectionMode   all;
    volumeMode      specific;
    sources
    {
        U           (({{ accel }} 0 0) 0);
    }
}
