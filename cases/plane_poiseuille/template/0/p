FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Kinematic pressure p/rho. The driving gradient is in fvOptions, so p stays ~0.
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    ".*Wall"
    {
        type            zeroGradient;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}
