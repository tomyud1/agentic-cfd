FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-12;
        relTol          {{ p_relTol }};
    }
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0.1;
    }
}

// Steady SIMPLEC. The problem is NONLINEAR (convection), so velocity is under-relaxed.
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    pRefCell        0;
    pRefValue       0;
    residualControl
    {
        U           {{ res_U }};
        p           {{ res_p }};
    }
}

relaxationFactors
{
    equations
    {
        U           {{ relax_U }};
    }
}
