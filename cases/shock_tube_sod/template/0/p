FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

// Left state everywhere; setFields then writes the right state into the right half.
internalField   uniform {{ p_L }};

boundaryField
{
    leftEnd
    {
        type            zeroGradient;
    }
    rightEnd
    {
        type            zeroGradient;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}
