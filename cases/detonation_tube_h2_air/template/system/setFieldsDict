FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue p {{ p_0 }}
    volScalarFieldValue T {{ T_0 }}
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) ({{ L_ign }} 1 1);
        fieldValues
        (
            volScalarFieldValue p {{ p_ign }}
            volScalarFieldValue T {{ T_ign }}
        );
    }
);
