FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

ddtSchemes
{
    default         {{ ddt }};
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
    div(phi,U)      Gauss {{ limiter }}V 1;
    div(phi,Yi_h)   Gauss {{ limiter }} 1;
    div(phi,K)      Gauss {{ limiter }} 1;
    div(phid,p)     Gauss {{ limiter }} 1;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}
