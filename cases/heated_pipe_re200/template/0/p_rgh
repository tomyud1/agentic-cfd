FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        rho             rhok;
        value           uniform 0;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    "(unheatedWall|heatedWall)"
    {
        type            fixedFluxPressure;
        rho             rhok;
        value           uniform 0;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}
