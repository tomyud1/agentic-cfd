FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      chemistryProperties;
}

chemistryType
{
    solver          {{ chem_solver }};
}

chemistry       on;

initialChemicalTimeStep {{ init_chem_dt }};

EulerImplicitCoeffs
{
    cTauChem        1;
    equilibriumRateLimiter off;
}

odeCoeffs
{
    solver          {{ ode_solver }};
    absTol          {{ abs_tol }};
    relTol          {{ rel_tol }};
}
